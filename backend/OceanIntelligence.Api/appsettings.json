{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GlobalFishingWatch": {
    "BaseUrl": "https://gateway.api.globalfishingwatch.org"
  },
  "ApiProtection": {
    "AreaSearchCacheExpiration": "00:30:00",
    "VesselDetailsCacheExpiration": "1.00:00:00",
    "AreaSearchRateLimit": {
      "PermitLimit": 6,
      "Window": "00:01:00"
    },
    "VesselDetailsRateLimit": {
      "PermitLimit": 60,
      "Window": "00:01:00"
    }
  },
  "AllowedHosts": "*"
}
